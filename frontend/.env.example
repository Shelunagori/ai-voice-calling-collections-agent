# Public URL of the FastAPI backend (HTTPS in production). The browser derives the
# WebSocket URL (wss://) from it. Not a secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional: public URL shown on the landing page / README
NEXT_PUBLIC_SITE_URL=

# SERVER-ONLY (read by app/api/operator/* route handlers; never prefix with NEXT_PUBLIC_).
# OPERATOR_TOKEN must equal the backend's OPERATOR_TOKEN. OPERATOR_CONSOLE_PASSWORD is what an
# operator types on the Sessions page to open phone-call audit trails (HttpOnly cookie, 8 h).
OPERATOR_TOKEN=
OPERATOR_CONSOLE_PASSWORD=
# Optional server-side backend URL (defaults to NEXT_PUBLIC_API_BASE_URL)
BACKEND_API_BASE_URL=
