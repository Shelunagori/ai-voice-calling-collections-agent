# ---------------------------------------------------------------------------
# AI Voice Collections Agent — environment reference.
# Copy to .env (repo root) or backend/.env. NEVER commit real values.
# Everything is optional: with no values the app runs fully on mock providers.
# ---------------------------------------------------------------------------

# --- core ---------------------------------------------------------------
APP_ENV=local                      # local | test | staging | production
LOG_LEVEL=INFO
PORT=8000                          # Railway injects PORT automatically
# PostgreSQL in production (postgres://, postgresql:// and postgresql+asyncpg:// accepted; sslmode= is
# translated for asyncpg). Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
# Default when unset or empty: sqlite+aiosqlite:///./local.db. That is DEVELOPMENT ONLY: the file lives inside
# the container. With APP_ENV=production/staging (or on Railway) the backend refuses to start on it.
DATABASE_URL=
AUTO_MIGRATE=true                  # run Alembic upgrade head on startup; if false, production requires the schema at head
# ALLOW_EPHEMERAL_DATABASE=true    # EMERGENCY/DEV ESCAPE HATCH ONLY. Lets production start without PostgreSQL
#                                  # (logged CRITICAL); all sessions/audit/stop-contact data is lost on redeploy.
SEED_DEMO_DATA=true                # upsert the synthetic scenarios on startup
TRANSCRIPT_RETENTION_DAYS=30       # transcript text is nulled after this; raw audio is never stored
FRONTEND_URL=http://localhost:3000 # CORS + WebSocket origin allow-list
CORS_EXTRA_ORIGINS=                # comma-separated extra origins
PUBLIC_BASE_URL=http://localhost:8000

# --- provider selection (mock | real) ------------------------------------
LLM_PROVIDER=mock                  # mock | cloudflare
STT_PROVIDER=mock                  # mock | cartesia
TTS_PROVIDER=mock                  # mock | cartesia
RESPONSE_MODE=template             # template | llm (LLM rephrases approved text; guarded)
JUDGE_PROVIDER=mock                # mock | cloudflare (evaluation LLM-as-judge)

# --- Cloudflare Workers AI --------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=              # token with Workers AI permission
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_AI_LORA=                # optional BYO LoRA finetune id/name (post-trained NLU); empty = 70B JSON mode
CLOUDFLARE_AI_LORA_MODEL=@cf/google/gemma-2b-it-lora
CLOUDFLARE_JUDGE_MODEL=            # optional; defaults to CLOUDFLARE_AI_MODEL
LLM_TIMEOUT_S=2.5                  # overall deadline per LLM call; rules fallback after it
LLM_MAX_RETRIES=1

# --- Cartesia ---------------------------------------------------------------
CARTESIA_API_KEY=
CARTESIA_VERSION=2026-08-14
CARTESIA_STT_MODEL=ink-whisper     # supports the language parameter (en/ja)
CARTESIA_TTS_MODEL=sonic-3
CARTESIA_VOICE_ID=                 # English voice id
CARTESIA_VOICE_ID_JA=              # Japanese voice id (falls back to CARTESIA_VOICE_ID)

# --- Twilio (PSTN) ----------------------------------------------------------
TELEPHONY_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=               # E.164 caller id owned by the account
TWILIO_WEBHOOK_BASE_URL=           # public HTTPS base of this backend, e.g. https://api.example.com
TWILIO_TRANSFER_NUMBER=            # E.164 number for human transfer; empty = transfer simulated
DEMO_CALL_ALLOWED_NUMBERS=         # comma-separated E.164 numbers the operator may dial
OPERATOR_TOKEN=                    # long random string; required for operator endpoints
VALIDATE_TWILIO_SIGNATURES=true

# --- runtime limits -----------------------------------------------------------
BARGE_IN_MIN_SPEECH_MS=250
MAX_CONCURRENT_SESSIONS=25
SESSION_IDLE_TIMEOUT_S=300
RATE_LIMIT_SESSIONS_PER_MINUTE=10
RATE_LIMIT_CALLS_PER_HOUR=5
TRUST_PROXY_HEADERS=true           # use the right-most X-Forwarded-For entry; set false if port 8000 is directly reachable

# --- simulated demo policy (NOT legal requirements) ----------------------------
# POLICY_COUNTRY=JP applies the simulated outbound calling window below (Asia/Tokyo 08:00-21:00).
# Empty (POLICY_COUNTRY=) or any other value: the calling-window rule is NOT_APPLICABLE for outbound
# demo calls; the max-contact-attempts and stop-contact rules still run. Default when unset: JP.
POLICY_COUNTRY=JP
POLICY_TIMEZONE=Asia/Tokyo
POLICY_CALLING_START_HOUR=8
POLICY_CALLING_END_HOUR=21
POLICY_MAX_CONTACT_ATTEMPTS=3
POLICY_MAX_IDENTITY_ATTEMPTS=2

# --- frontend (build time, public) ---------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- frontend server (Next.js route handlers only; SERVER-ONLY, never NEXT_PUBLIC_) ---
# Needed for phone-session audit detail and Start Call. The Next.js server adds
# `Authorization: Bearer $OPERATOR_TOKEN` to exactly two backend routes (GET /api/sessions/{id},
# POST /api/operator/calls); the browser never sees it. There is no browser login.
# OPERATOR_TOKEN=                  # same value as the backend's OPERATOR_TOKEN
# BACKEND_API_BASE_URL=            # optional server-side backend URL; defaults to NEXT_PUBLIC_API_BASE_URL
